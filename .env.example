# Optional. Without a key, local text/PDF/PPTX and the extractive tutor work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Persistent SQLite and original files (relative to the project root).
TUTORA_DATA_DIR=data

# Local dev ports. Defaults are 8000 (API) and 5173 (UI); if another project already
# listens there, Tutora moves to the next free port instead of failing. Set these to
# pin different values, TUTORA_API_URL to point the UI at a remote API, or
# TUTORA_STRICT_PORT=1 to fail when the preferred UI port is taken.
# TUTORA_API_PORT=8010
# TUTORA_WEB_PORT=5180
# TUTORA_API_URL=http://127.0.0.1:8010

# This file is read by the backend (backend/env.py) and by Vite. Real environment
# variables always win, TUTORA_ENV_FILE points at a different file, and
# TUTORA_SKIP_ENV_FILE=1 ignores it entirely (the test suite sets that).
